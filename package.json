{
  "name": "shiftpatch",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter api start",
