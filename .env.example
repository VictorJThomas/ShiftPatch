# Local values for docker-compose.yml. Copy to .env. No real secrets here.
DATABASE_URL=postgres://shiftpatch:shiftpatch@localhost:5432/shiftpatch

JWT_SECRET=change-me-to-32+-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Proxy hops in front of the API (prod: Vercel rewrite + Railway edge = 2). 0/unset locally.
TRUST_PROXY=0
API_ORIGIN=http://localhost:3001

# Storage: MinIO locally (R2_* names kept so prod uses the same code path)
S3_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=shiftpatch
R2_SECRET_ACCESS_KEY=shiftpatch-secret
R2_PUBLIC_BUCKET=public-assets
R2_PRIVATE_BUCKET=private-credentials
R2_PUBLIC_BASE_URL=http://localhost:9000/public-assets

# Email: Mailpit locally (UI http://localhost:8025); Resend in production
# MAIL_TRANSPORT: log (default, prints metadata only) | smtp (Mailpit on SMTP_HOST:SMTP_PORT) | resend (needs RESEND_API_KEY).
# Missing or invalid mail config falls back to log; the API still boots.
MAIL_TRANSPORT=log
MAIL_FROM=ShiftPatch <no-reply@shiftpatch.local>
RESEND_API_KEY=
# Outbox dispatcher (in-process, started by server.ts only): OUTBOX_DISPATCHER=off disables it; interval default 10000 ms.
OUTBOX_DISPATCHER=on
OUTBOX_INTERVAL_MS=10000
# EMAIL_FROM is the legacy name of MAIL_FROM (still read as a fallback)
EMAIL_FROM=ShiftPatch <no-reply@shiftpatch.local>
EMAIL_REDIRECT_TO=
SMTP_HOST=localhost
SMTP_PORT=1025

LOG_LEVEL=info
