# Local values for docker-compose.yml. Copy to .env. No real secrets here.
DATABASE_URL=postgres://shiftpatch:shiftpatch@localhost:5432/shiftpatch

JWT_SECRET=change-me-to-32+-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Storage: MinIO locally (R2_* names kept so prod uses the same code path)
S3_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=shiftpatch
R2_SECRET_ACCESS_KEY=shiftpatch-secret
R2_PUBLIC_BUCKET=public-assets
R2_PRIVATE_BUCKET=private-credentials
R2_PUBLIC_BASE_URL=http://localhost:9000/public-assets

# Email: Mailpit locally (UI http://localhost:8025); Resend in production
RESEND_API_KEY=
EMAIL_FROM=ShiftPatch <no-reply@shiftpatch.local>
EMAIL_REDIRECT_TO=
SMTP_HOST=localhost
SMTP_PORT=1025

LOG_LEVEL=info
